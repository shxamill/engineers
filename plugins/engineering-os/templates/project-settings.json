{
  "$comment": "Recommended project .claude/settings.json additions written by /engineering-os:eng-init (plugins cannot ship permissions or sandbox). Merge; do not overwrite existing keys.",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": ["registry.npmjs.org", "pypi.org", "files.pythonhosted.org", "github.com", "api.github.com", "objects.githubusercontent.com"]
    }
  }
}
